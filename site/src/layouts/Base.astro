---
import "../styles/global.css";

type Props = { title: string };
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Technical jobs for African candidates, linked to their original source." />
    <title>{title}</title>
  </head>
  <body>
    <main><slot /></main>
  </body>
</html>
