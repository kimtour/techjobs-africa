---
import Base from "../layouts/Base.astro";
import { employers, directoryEntries, sectorNames } from "../lib/employers";
import { jobs } from "../lib/jobs";
const counts = new Map<string, number>();
for (const job of jobs) {
  if (job.employer_id && job.eligibility_level !== "RESTRICTED") {
    counts.set(job.employer_id, (counts.get(job.employer_id) ?? 0) + 1);
  }
}
---
<Base title="Employer careers directory — TechKazi">
  <section class="hero">
    <p class="eyebrow">TechKazi · Employer directory</p>
    <h1>Find the original careers website.</h1>
    <p class="lede">Browse {employers.length} employer records from {directoryEntries} researched entries. These are recruitment links, not a list of open jobs. Global boards require checking each role’s location and eligibility.</p>
    <nav class="page-links" aria-label="Browse"><a href="/">← Browse collected tech jobs</a></nav>
  </section>
  <form class="filters" id="directory-filters" role="search">
    <label><span>Employer</span><input id="directory-search" type="search" placeholder="Search employer names…" /></label>
    <label><span>Sector</span><select id="directory-sector"><option value="">All sectors</option>{sectorNames.map(s => <option value={s}>{s}</option>)}</select></label>
  </form>
  <p id="directory-count" role="status" aria-live="polite">{employers.length} employer records</p>
  <ul class="directory-list">
    {employers.map(e => <li class="directory-card" data-employer-card data-name={[e.name, ...e.aliases].join(" ").toLowerCase()} data-sectors={JSON.stringify(e.sectors)}>
      <h2>{e.name}</h2><p class="meta">{e.sectors.join(" · ")}</p>
      <div class="directory-links">
        {e.website && <a href={e.website} target="_blank" rel="noreferrer">Employer website ↗</a>}
        {e.sources.map((s, i) => <div>
          <a href={s.url} target="_blank" rel="noreferrer">Visit careers website{e.sources.length > 1 ? ` ${i + 1}` : ""} ↗</a>
          <span class="meta"> · {s.status === "active" ? "Collected by TechKazi" : ["verified", "trial"].includes(s.status) ? "Source under evaluation" : s.status === "blocked" ? "Automated access blocked" : s.status === "retired" ? "Historical recruitment link" : "Link not yet independently verified by TechKazi"}</span>
        </div>)}
        {e.sources.length === 0 && <p class="meta">No recruitment link verified.</p>}
        {(counts.get(e.id) ?? 0) > 0 && <a href={`/?employer=${encodeURIComponent(e.id)}`}>View jobs collected by TechKazi ({counts.get(e.id)})</a>}
      </div>
    </li>)}
  </ul>
  <p id="directory-empty" class="empty" hidden>No employers match those filters.</p>
  <button id="directory-more" class="more" type="button" hidden>Show more employers</button>
  <script src="../scripts/employers.js"></script>
</Base>
