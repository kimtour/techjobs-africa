---
import Base from "../layouts/Base.astro";
import {
  companyLabel,
  jobs,
  locationLabel,
  postedLabel,
  sourceName,
  sourceOrder,
  newestFirst,
} from "../lib/jobs";

const visibleJobs = jobs.filter((job) => job.eligibility_level !== "RESTRICTED");
const categories = [...new Set(visibleJobs.map((job) => job.category).filter(Boolean))].sort();
const orderedSources = [
  ...sourceOrder,
  ...[...new Set(visibleJobs.flatMap((job) => job.sources))].filter(
    (sourceId) => !sourceOrder.includes(sourceId),
  ),
];
const sourceGroups = orderedSources
  .map((sourceId) => ({
    sourceId,
    jobs: visibleJobs.filter((job) => job.sources.includes(sourceId)).sort(newestFirst),
  }))
  .filter((group) => group.jobs.length > 0 || group.sourceId === "linkedin");
const sourceColumns: (typeof sourceGroups)[] = [[], []];
const feedGroups = [{ sourceId: "all", jobs: [...visibleJobs].sort(newestFirst) }, ...sourceGroups];
feedGroups.forEach((group, index) => sourceColumns[index % sourceColumns.length].push(group));
---

<Base title="TechJobs Africa">
  <section class="hero">
    <p class="eyebrow">TechJobs Africa</p>
    <h1>Technical jobs for African candidates.</h1>
    <p class="lede">Minimal listings from approved sources. Apply on the original site.</p>
  </section>

  <section class="results" aria-labelledby="jobs-heading">
    <div class="results-heading">
      <h2 id="jobs-heading">Open roles</h2>
      <p id="job-count">{visibleJobs.length} active roles</p>
    </div>
    {
      visibleJobs.length ? (
        <>
          <form class="filters" id="job-filters">
            <label>
              <span>Search</span>
              <input id="job-search" name="search" placeholder="QA, Product, Python…" type="search" />
            </label>
            <label>
              <span>Category</span>
              <select id="category-filter" name="category">
                <option value="">All categories</option>
                {categories.map((category) => <option value={category}>{category}</option>)}
              </select>
            </label>
          </form>
          <p class="empty" hidden id="no-results">No jobs match those filters.</p>
          <div id="source-groups" class="source-columns">
            {sourceColumns.map((column) => (
              <div class="source-column">
                {column.map((group) => (
              <section class="source-group" style={`order: ${feedGroups.indexOf(group)}`} data-source={group.sourceId} data-source-group data-limit="10" aria-labelledby={`source-${group.sourceId}`}>
                <div class="source-heading">
                  <div>
                    <h3 id={`source-${group.sourceId}`}>{sourceName(group.sourceId)}</h3>
                    {group.sourceId === "linkedin" && <p class="source-provider">Via JSearch · Kenya</p>}
                    <div class="source-periods" aria-label={`${sourceName(group.sourceId)} posting period`}>
                      <button aria-pressed="true" data-period="latest" type="button">Latest</button>
                      <span aria-hidden="true">•</span>
                      <button aria-pressed="false" data-period="day" type="button">Day</button>
                      <span aria-hidden="true">•</span>
                      <button aria-pressed="false" data-period="three-days" type="button">3 Days</button>
                      <span aria-hidden="true">•</span>
                      <button aria-pressed="false" data-period="week" type="button">Week</button>
                      <span aria-hidden="true">•</span>
                      <button aria-pressed="false" data-period="two-weeks" type="button">2 Weeks</button>
                      <span aria-hidden="true">•</span>
                      <button aria-pressed="false" data-period="month" type="button">Month</button>
                    </div>
                  </div>
                  <p data-source-count>{group.jobs.length} recent listing{group.jobs.length === 1 ? "" : "s"}</p>
                </div>
                <div class="source-feed" tabindex="0" role="region" aria-labelledby={`source-${group.sourceId}`} data-source-feed>
                <ul class="job-list">
                  {group.jobs.map((job, index) => (
                    <li
                      class="job-card"
                      data-source-card
                      data-job-id={job.job_id}
                      data-index={index}
                      data-category={job.category ?? ""}
                      data-published={job.published_at || job.published_date || ""}
                      data-search={[job.title, companyLabel(job), locationLabel(job), job.category]
                        .filter(Boolean)
                        .join(" ")}
                      hidden={index >= 10}
                    >
                      <div>
                        {job.category && <p class="category">{job.category}</p>}
                        <h4>
                          <a class="job-title" href={job.preferred_apply_url} rel="noreferrer" target="_blank">
                            {job.title} <span aria-hidden="true">↗</span>
                          </a>
                        </h4>
                        <p class="company">{companyLabel(job)}</p>
                        <p class="meta">{locationLabel(job)}</p>
                        <p class="posted">
                          Posted: {(job.published_at || job.published_date) ? <time datetime={job.published_at || job.published_date}>{postedLabel(job)}</time> : postedLabel(job)}
                        </p>
                        {(group.sourceId === "all" || job.sources.length > 1) && <p class="source">{group.sourceId === "all" ? "Source: " : "Also listed by: "}{job.sources.map(sourceName).join(", ")}</p>}
                      </div>
                    </li>
                  ))}
                </ul>
                <p class="empty source-empty" data-source-empty hidden>No jobs in this period match your filters. Try Latest.</p>
                {group.jobs.length > 10 && <button class="more" data-more type="button">Load more jobs</button>}
                </div>
                <p class="source-status" data-source-status role="status" aria-live="polite">Showing {Math.min(10, group.jobs.length)} of {group.jobs.length} jobs · Scroll for more</p>
              </section>
                ))}
              </div>
            ))}
          </div>
        </>
      ) : (
        <p class="empty">The first verified job update will appear here soon.</p>
      )
    }
  </section>
  <script src="/filters.js" defer></script>
</Base>
